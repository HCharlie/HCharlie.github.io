<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · HCharlie</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #0f1419;
      --panel: color-mix(in srgb, var(--bg) 84%, white 16%);
      --fg: #e7ecf3;
      --muted: #94a3b8;
      --accent: #5ab0ff;
      --border: color-mix(in srgb, var(--fg) 14%, transparent);
      --shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f6f8fc;
        --panel: #ffffff;
        --fg: #0f172a;
        --muted: #5b6475;
        --accent: #0f7ae5;
        --border: rgba(15, 23, 42, 0.12);
        --shadow: 0 18px 55px rgba(15, 23, 42, 0.08);
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 12%, transparent), transparent 32%),
        linear-gradient(180deg, var(--bg), color-mix(in srgb, var(--bg) 90%, black 10%));
      color: var(--fg);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.65;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    a:hover { color: var(--accent); }
    .shell {
      width: min(1100px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 1rem 0 3rem;
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.75rem 0 1.5rem;
    }
    .brand { font-weight: 750; letter-spacing: -0.02em; }
    .nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      color: var(--muted);
      font-size: 0.95rem;
    }
    .nav a { padding: 0.25rem 0; }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--muted);
      font-size: 0.95rem;
      margin-top: 0.25rem;
    }
    .hero {
      padding: clamp(1.5rem, 5vw, 2.5rem);
      border: 1px solid var(--border);
      border-radius: 28px;
      background: color-mix(in srgb, var(--panel) 94%, transparent);
      box-shadow: var(--shadow);
      backdrop-filter: blur(10px);
    }
    .eyebrow {
      margin: 0 0 0.55rem;
      color: var(--accent);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    h1 {
      margin: 0;
      font-size: clamp(2rem, 6vw, 3.8rem);
      line-height: 1;
      letter-spacing: -0.05em;
    }
    .content {
      margin-top: 1.25rem;
      padding: clamp(1.25rem, 3vw, 2rem);
      border: 1px solid var(--border);
      border-radius: 24px;
      background: color-mix(in srgb, var(--panel) 92%, transparent);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    }
    .content > * + * { margin-top: 1rem; }
    .content p,
    .content li { color: var(--muted); }
    .content h2 {
      margin: 2rem 0 0.75rem;
      font-size: 1.35rem;
      line-height: 1.2;
      color: var(--fg);
    }
    .content h3 {
      margin: 1.5rem 0 0.5rem;
      font-size: 1.05rem;
      color: var(--fg);
    }
    .content a { color: var(--accent); }
    .content ul,
    .content ol { padding-left: 1.2rem; }
    .content li + li { margin-top: 0.45rem; }
    .mermaid {
      margin: 1.5rem 0;
      overflow-x: auto;
      text-align: center;
    }
    @media (max-width: 720px) {
      .topbar { align-items: flex-start; flex-direction: column; }
      .hero { border-radius: 22px; }
      .content { border-radius: 20px; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <a class="brand" href="/">HCharlie</a>
      <nav class="nav" aria-label="Primary">
        <a href="/patterns/">Series</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="https://github.com/HCharlie">GitHub</a>
      </nav>
    </header>

    <a class="back-link" href="/">← Home</a>
    <section class="hero" aria-labelledby="page-title">
      {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
      <h1 id="page-title">{{ title }}</h1>
    </section>

    <article class="content">
      {{ content }}
    </article>
  </main>
  {% if mermaid %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.16.1/dist/mermaid.esm.min.mjs";
    mermaid.initialize({
      startOnLoad: true,
      theme: window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "default"
    });
  </script>
  {% endif %}
</body>
</html>
